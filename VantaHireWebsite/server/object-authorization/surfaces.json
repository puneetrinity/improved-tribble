{
  "format_version": 1,
  "source_commit": "ae84dcf9af22ac15cca0fe1eaf546ee338fff779",
  "route_registration_census": 316,
  "contract": "Application object reads and workflow mutations plus current membership/seat-scoped job, roster and hiring-manager directory reads are fail-closed; workflow authorization and mutation share one statement; the identity directory uses a statement-bound minimum projection; resume locator proxies and client-side download tracking are retired.",
  "routes": [
    {
      "method": "get",
      "path": "/api/applications/:id/history",
      "reader": "readAuthorizedApplicationStageHistory",
      "projection": ["fromStage", "toStage", "changedAt", "notes"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/email-history",
      "reader": "readAuthorizedApplicationEmailHistory",
      "projection": ["id", "templateName", "templateType", "recipientEmail", "sentAt", "status", "sentBy"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/interview/ics",
      "reader": "readAuthorizedApplicationInterviewInvite",
      "projection": ["candidateName", "candidateEmail", "jobTitle", "interviewDate", "interviewTime", "interviewLocation", "interviewNotes"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/whatsapp-history",
      "reader": "readAuthorizedApplicationWhatsAppHistory",
      "projection": ["templateName", "templateType", "status", "sentAt", "deliveredAt", "readAt", "sentBy"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/resume",
      "reader": "readAuthorizedApplicationResumeFile",
      "projection": ["applicationId", "organizationId", "resumeUrl", "resumeFilename"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/resume-text",
      "reader": "readAuthorizedApplicationResumeText",
      "projection": ["applicationId", "organizationId", "text"]
    },
    {
      "method": "get",
      "path": "/api/jobs/:id/applications",
      "reader": "requireSeat+isRecruiterOnJob",
      "projection": ["existingApplicationCollection"]
    },
    {
      "method": "get",
      "path": "/api/subscription/seats/usage",
      "reader": "requireSeat+getSeatUsage",
      "projection": ["existingSeatUsage", "existingSeatRoster"]
    },
    {
      "method": "get",
      "path": "/api/users",
      "reader": "readAuthorizedHiringManagerDirectory",
      "projection": ["id", "username", "firstName", "lastName", "role"]
    },
    {
      "method": "patch",
      "path": "/api/applications/:id/stage",
      "reader": "moveAuthorizedApplicationStage",
      "projection": ["applicationId", "stageId", "stageName", "changedAt"]
    },
    {
      "method": "patch",
      "path": "/api/applications/:id/interview",
      "reader": "scheduleAuthorizedApplicationInterview",
      "projection": ["applicationId", "interviewDate", "interviewTime", "interviewLocation", "interviewNotes", "updatedAt"]
    },
    {
      "method": "patch",
      "path": "/api/applications/bulk/interview",
      "reader": "scheduleAuthorizedBulkApplicationInterviews",
      "projection": ["applicationId", "interviewDate", "interviewTime", "interviewLocation", "interviewNotes", "updatedAt"]
    },
    {
      "method": "post",
      "path": "/api/applications/:id/notes",
      "reader": "addAuthorizedApplicationReviewerNote",
      "projection": ["applicationId", "note"]
    },
    {
      "method": "patch",
      "path": "/api/applications/:id/rating",
      "reader": "setAuthorizedApplicationReviewerRating",
      "projection": ["applicationId", "reviewerId", "rating", "rubricVersion", "updatedAt"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/feedback",
      "reader": "readAuthorizedApplicationFeedback",
      "projection": ["id", "applicationId", "authorId", "overallScore", "recommendation", "notes", "rubricVersion", "createdAt", "updatedAt", "author"]
    },
    {
      "method": "post",
      "path": "/api/applications/:id/feedback",
      "reader": "addAuthorizedApplicationFeedback",
      "projection": ["id", "applicationId", "authorId", "overallScore", "recommendation", "notes", "rubricVersion", "createdAt", "updatedAt", "author"]
    }
  ],
  "retired_routes": [
    { "method": "patch", "path": "/api/applications/:id/download", "code": "RESUME_DOWNLOAD_TRACKING_RETIRED" },
    { "method": "get", "path": "/api/candidates/external-resume", "code": "EXTERNAL_RESUME_PROXY_RETIRED" }
  ],
