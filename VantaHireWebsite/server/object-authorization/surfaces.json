  "route_registration_census": 316,
  "contract": "Application object reads, workflow mutations, AI candidate context, similarity, email context and provider handoff plus current membership/seat-scoped job, roster, hiring-manager, financial-document, organization-activity, routine-admin, talent-pool and organization privilege commands are fail-closed; protected authorization and mutations share statement-bound grants; organization member privilege changes and password changes advance the affected account authorization version atomically; legacy numeric sessions are version-1 compatible and new sessions carry only id plus authVersion; provider/file work follows exact authorization; resume locator proxies, client-side download tracking, the routine admin application collection and consultant product are retired. Seat-capacity serialization, password-reset token clearing, organization provisioning after the owner grant and talent-pool conversion/suggestions remain outside this closure.",
  "routes": [
    {
      "method": "get",
      "path": "/api/applications/:id/history",
      "reader": "readAuthorizedApplicationStageHistory",
      "projection": ["fromStage", "toStage", "changedAt", "notes"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/email-history",
      "reader": "readAuthorizedApplicationEmailHistory",
