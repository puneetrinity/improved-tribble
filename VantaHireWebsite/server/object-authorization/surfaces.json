{
  "format_version": 1,
  "source_commit": "ae84dcf9af22ac15cca0fe1eaf546ee338fff779",
  "route_registration_census": 316,
  "contract": "Application object reads, workflow mutations, AI candidate context, similarity, email context and provider handoff plus current membership/seat-scoped job, roster and hiring-manager directory reads are fail-closed; protected authorization and mutations share statement-bound grants; provider work follows the final privacy fence; resume locator proxies and client-side download tracking are retired.",
  "routes": [
    {
      "method": "get",
      "path": "/api/applications/:id/history",
      "reader": "readAuthorizedApplicationStageHistory",
      "projection": ["fromStage", "toStage", "changedAt", "notes"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/email-history",
      "reader": "readAuthorizedApplicationEmailHistory",
      "projection": ["id", "templateName", "templateType", "recipientEmail", "sentAt", "status", "sentBy"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/interview/ics",
      "reader": "readAuthorizedApplicationInterviewInvite",
      "projection": ["candidateName", "candidateEmail", "jobTitle", "interviewDate", "interviewTime", "interviewLocation", "interviewNotes"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/whatsapp-history",
      "reader": "readAuthorizedApplicationWhatsAppHistory",
      "projection": ["templateName", "templateType", "status", "sentAt", "deliveredAt", "readAt", "sentBy"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/resume",
      "reader": "readAuthorizedApplicationResumeFile",
      "projection": ["applicationId", "organizationId", "resumeUrl", "resumeFilename"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/resume-text",
      "reader": "readAuthorizedApplicationResumeText",
      "projection": ["applicationId", "organizationId", "text"]
    },
    {
      "method": "get",
      "path": "/api/jobs/:id/applications",
      "reader": "requireSeat+isRecruiterOnJob",
      "projection": ["existingApplicationCollection"]
    },
    {
      "method": "get",
      "path": "/api/subscription/seats/usage",
      "reader": "requireSeat+getSeatUsage",
      "projection": ["existingSeatUsage", "existingSeatRoster"]
    },
    {
      "method": "get",
      "path": "/api/users",
      "reader": "readAuthorizedHiringManagerDirectory",
      "projection": ["id", "username", "firstName", "lastName", "role"]
    },
    {
      "method": "patch",
      "path": "/api/applications/:id/stage",
      "reader": "moveAuthorizedApplicationStage",
      "projection": ["applicationId", "stageId", "stageName", "changedAt"]
    },
    {
      "method": "patch",
      "path": "/api/applications/:id/interview",
      "reader": "scheduleAuthorizedApplicationInterview",
      "projection": ["applicationId", "interviewDate", "interviewTime", "interviewLocation", "interviewNotes", "updatedAt"]
    },
    {
      "method": "patch",
      "path": "/api/applications/bulk/interview",
      "reader": "scheduleAuthorizedBulkApplicationInterviews",
      "projection": ["applicationId", "interviewDate", "interviewTime", "interviewLocation", "interviewNotes", "updatedAt"]
    },
    {
      "method": "post",
      "path": "/api/applications/:id/notes",
      "reader": "addAuthorizedApplicationReviewerNote",
      "projection": ["applicationId", "note"]
    },
    {
      "method": "patch",
      "path": "/api/applications/:id/rating",
      "reader": "setAuthorizedApplicationReviewerRating",
      "projection": ["applicationId", "reviewerId", "rating", "rubricVersion", "updatedAt"]
    },
    {
      "method": "get",
      "path": "/api/applications/:id/feedback",
      "reader": "readAuthorizedApplicationFeedback",
      "projection": ["id", "applicationId", "authorId", "overallScore", "recommendation", "notes", "rubricVersion", "createdAt", "updatedAt", "author"]
    },
    {
      "method": "post",
      "path": "/api/applications/:id/feedback",
      "reader": "addAuthorizedApplicationFeedback",
      "projection": ["id", "applicationId", "authorId", "overallScore", "recommendation", "notes", "rubricVersion", "createdAt", "updatedAt", "author"]
    },
    {
      "method": "post",
      "path": "/api/applications/:id/ai-summary",
      "reader": "readAuthorizedApplicationAiSummaryContext+publishAuthorizedApplicationAiSummary",
      "projection": ["message", "summary"]
    },
    {
      "method": "get",
      "path": "/api/jobs/:id/ai-similar-candidates",
      "reader": "readAuthorizedSimilarCandidates",
      "projection": ["applicationId", "candidateName", "candidateEmail", "sourceJobId", "sourceJobTitle", "aiFitScore", "aiFitLabel", "currentStage"]
    },
    {
      "method": "post",
      "path": "/api/applications/:id/send-email",
      "reader": "readAuthorizedManualEmailContext+sendAuthorizedTemplatedEmail",
      "projection": ["success"]
    },
    {
      "method": "post",
      "path": "/api/email/draft",
      "reader": "readAuthorizedEmailDraftContext+recordAuthorizedEmailDraftUsage",
      "projection": ["subject", "body"]
    },
    { "method": "post", "path": "/api/forms/templates", "reader": "createScopedFormTemplate", "projection": ["id", "name", "description", "isPublished", "createdBy", "createdAt", "updatedAt", "ownershipScope", "canManage", "fields"] },
    { "method": "get", "path": "/api/forms/templates", "reader": "listAuthorizedFormTemplates", "projection": ["id", "name", "description", "isPublished", "createdBy", "createdAt", "updatedAt", "ownershipScope", "canManage", "fields"] },
    { "method": "get", "path": "/api/forms/templates/:id", "reader": "readAuthorizedFormTemplate", "projection": ["id", "name", "description", "isPublished", "createdBy", "createdAt", "updatedAt", "ownershipScope", "canManage", "fields"] },
    { "method": "patch", "path": "/api/forms/templates/:id", "reader": "updateAuthorizedFormTemplate", "projection": ["id", "name", "description", "isPublished", "createdBy", "createdAt", "updatedAt", "ownershipScope", "canManage", "fields"] },
    { "method": "delete", "path": "/api/forms/templates/:id", "reader": "deleteAuthorizedFormTemplate", "projection": ["success"] },
    { "method": "get", "path": "/api/forms/:id/responses", "reader": "readAuthorizedResponsesForForm", "projection": ["form", "responses", "total"] },
    { "method": "get", "path": "/api/client-shortlist/:token", "reader": "readPublicClientShortlist", "projection": ["title", "message", "client", "job", "candidates", "createdAt", "expiresAt"] },
    { "method": "post", "path": "/api/client-shortlist/:token/feedback", "reader": "resolvePublicFeedbackTarget", "projection": ["success", "count", "message"] },
    { "method": "get", "path": "/api/client-shortlist/:token/resume/:candidateRef", "reader": "readPublicResumeLocator", "projection": ["bounded_file_or_redirect"] },
    { "method": "get", "path": "/api/applications/:id/client-feedback", "reader": "readAuthorizedClientFeedback", "projection": ["id", "recommendation", "notes", "rating", "createdAt", "clientName"] },
    { "method": "post", "path": "/api/hiring-manager-invitations", "reader": "replaceAuthorizedHiringManagerInvitation", "projection": ["success", "message", "invitation"] },
    { "method": "get", "path": "/api/hiring-manager-invitations", "reader": "listAuthorizedHiringManagerInvitations", "projection": ["id", "email", "name", "status", "expiresAt", "createdAt", "inviterName"] },
    { "method": "delete", "path": "/api/hiring-manager-invitations/:id", "reader": "cancelAuthorizedHiringManagerInvitation", "projection": ["success", "message"] }
  ],
  "retired_routes": [
    { "method": "patch", "path": "/api/applications/:id/download", "code": "RESUME_DOWNLOAD_TRACKING_RETIRED" },
    { "method": "get", "path": "/api/candidates/external-resume", "code": "EXTERNAL_RESUME_PROXY_RETIRED" }
  ],
